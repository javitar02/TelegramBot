<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-WeatherTelegramBot-9b59ebe5-3dde-461d-9303-588512aaec46</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Telegram.Bot" Version="22.10.3.1" />
  </ItemGroup>

  <!--
    Las imágenes del repostaje se leen del disco al mandar el mensaje, así que tienen que
    estar junto al ejecutable, no solo en el proyecto.
  -->
  <ItemGroup>
    <Content Include="img/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
